# ============================================
# 科学家 AI 对话系统 - 环境变量配置
# ============================================
# 复制此文件为 .env 并填入你的配置
#   cp .env.example .env

# OpenAI 兼容 API Key（必填）
API_KEY=sk-your-api-key-here

# API 端点地址（默认 OpenAI，可换成其他兼容服务）
API_BASE=https://api.openai.com/v1

# 模型名称
API_MODEL=gpt-4o

# 最大回复 Token 数
MAX_TOKENS=800

# 回复创造性（0-2，越高越天马行空）
TEMPERATURE=0.8

# 服务器端口
PORT=8090